<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Qasim Sahito Academy</title>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial, sans-serif;
    background:#f4f7fb;
    color:#172033;
}

/* HEADER */

header{
    background:linear-gradient(135deg,#172554,#315bea,#6d4aff);
    color:white;
    padding:25px 20px;
    text-align:center;
}

.logo{
    width:65px;
    height:65px;
    margin:auto;
    border-radius:18px;
    background:white;
    color:#315bea;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:23px;
    font-weight:bold;
}

header h1{
    margin-top:12px;
    font-size:28px;
}

header p{
    margin-top:7px;
    opacity:.9;
}


/* HERO */

.hero{
    text-align:center;
    padding:45px 20px;
}

.hero h2{
    font-size:34px;
    margin-bottom:12px;
}

.hero p{
    color:#667085;
    max-width:650px;
    margin:auto;
    line-height:1.6;
}


/* SUBJECTS */

.section-title{
    text-align:center;
    margin:35px 20px 25px;
}

.section-title h2{
    font-size:30px;
}

.subjects{
    max-width:1100px;
    margin:auto;
    padding:20px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.card{
    background:white;
    padding:25px;
    border-radius:20px;
    text-align:center;
    box-shadow:0 8px 25px rgba(0,0,0,.08);
    transition:.2s;
}

.card:hover{
    transform:translateY(-5px);
}

.icon{
    font-size:42px;
    margin-bottom:15px;
}

.card h3{
    margin-bottom:10px;
}

.card p{
    color:#667085;
    font-size:14px;
    line-height:1.5;
}


/* PDF BUTTON */

.pdf-button{
    display:inline-block;
    margin-top:18px;
    padding:11px 16px;
    background:#315bea;
    color:white;
    text-decoration:none;
    border-radius:10px;
    font-weight:bold;
}

.pdf-button:hover{
    background:#172554;
}


/* RESOURCES */

.resources{
    max-width:1100px;
    margin:auto;
    padding:20px;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:20px;
}

.resource{
    background:white;
    padding:25px;
    border-radius:18px;
    box-shadow:0 8px 25px rgba(0,0,0,.07);
}

.resource span{
    color:#315bea;
    font-size:12px;
    font-weight:bold;
}

.resource h3{
    margin:10px 0;
}

.resource p{
    color:#667085;
    line-height:1.5;
}


/* ABOUT */

.about{
    max-width:1100px;
    margin:50px auto;
    padding:35px 20px;
}

.about-box{
    background:#111a38;
    color:white;
    border-radius:25px;
    padding:35px;
    text-align:center;
}

.about-box p{
    margin-top:12px;
    color:#cbd3ee;
    line-height:1.6;
}


/* FOOTER */

footer{
    margin-top:40px;
    padding:25px;
    text-align:center;
    background:#111a38;
    color:white;
}


/* MOBILE */

@media(max-width:800px){

    .subjects{
        grid-template-columns:repeat(2,1fr);
    }

    .resources{
        grid-template-columns:1fr;
    }

}

@media(max-width:500px){

    .subjects{
        grid-template-columns:1fr;
    }

    .hero h2{
        font-size:27px;
    }

    header h1{
        font-size:23px;
    }

}

</style>

</head>


